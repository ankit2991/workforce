PORT=5001
NODE_ENV=development
# On the deployed backend set a real MongoDB Atlas URL with credentials kept in host secrets.
DATABASE_URL=mongodb://localhost:27017/workforce_wallet
# Generate long unique secrets, never reuse example passwords in production.
JWT_ACCESS_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d
# Comma-separated CORS browser origins
FRONTEND_URL=https://workpay.manavtechlabs.com,http://localhost:5173
